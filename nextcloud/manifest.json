{
  "name": "nextcloud",
  "label": "Nextcloud",
  "description": "Cloud file storage (WebDAV, Notes, Calendar)",
  "version": "",
  "category": "community",
  "author": "cbcoutinho",
  "author_url": "https://github.com/cbcoutinho/nextcloud-mcp-server",
  "server": {
    "runtime": "python",
    "transport": "stdio",
    "command": "venv/bin/nextcloud-mcp-server",
    "args": ["run", "--transport", "stdio"],
    "source": "pypi:nextcloud-mcp-server[documents]"
  },
  "credentials": {
    "type": "per_user",
    "label": "Nextcloud",
    "description": "Connect your Nextcloud account",
    "fields": [
      {
        "key": "NEXTCLOUD_HOST",
        "label": "Nextcloud server URL, without a trailing / (https://cloud.example.com)",
        "input_type": "url"
      },
      {
        "key": "NEXTCLOUD_USERNAME",
        "label": "Username",
        "input_type": "text"
      },
      {
        "key": "NEXTCLOUD_PASSWORD",
        "label": "App password (Nextcloud: Settings > Security > Devices & sessions)",
        "input_type": "password"
      }
    ],
    "service_account": true
  },
  "env": {},
  "agent_env": {},
  "exclude_from": [],
  "skills": [
    {
      "id": "nextcloud-usage",
      "loading": "always",
      "file": "skills/nextcloud.md",
      "description": "Nextcloud files (read, write, the binary-document limits), its apps, and the safety rules",
      "default_exclude_from": []
    }
  ],
  "platform_min_version": "1.8.0",
  "replaces": [
    { "source": "npm:nextcloud-mcp-server", "credentials": { "NEXTCLOUD_URL": "NEXTCLOUD_HOST" } }
  ],
  "patched": false,
  "patch_note": null,
  "network_targets": [
    {
      "source": "per_user_credential",
      "host_key": "NEXTCLOUD_HOST",
      "port_default": 443
    }
  ]
}
