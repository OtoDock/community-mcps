{
  "name": "uptime-kuma",
  "label": "Uptime Kuma",
  "description": "Uptime monitoring dashboard (requires v2)",
  "version": "",
  "category": "community",
  "author": "DavidFuchs",
  "author_url": "https://github.com/DavidFuchs/mcp-uptime-kuma",
  "server": {
    "runtime": "node",
    "transport": "stdio",
    "command": "node",
    "args": [
      "${mcp_dir}/node_modules/@davidfuchs/mcp-uptime-kuma/dist/index.js"
    ],
    "source": "npm:@davidfuchs/mcp-uptime-kuma"
  },
  "credentials": {
    "type": "none"
  },
  "instances": {
    "delivery": "env",
    "fields": [
      {
        "key": "UPTIME_KUMA_URL",
        "label": "Uptime Kuma URL",
        "input_type": "url",
        "default": "http://localhost:3001",
        "required": true
      },
      {
        "key": "UPTIME_KUMA_USERNAME",
        "label": "Username (empty for an instance without login)",
        "input_type": "text"
      },
      {
        "key": "UPTIME_KUMA_PASSWORD",
        "label": "Password",
        "input_type": "password",
        "secret": true
      },
      {
        "key": "UPTIME_KUMA_JWT_TOKEN",
        "label": "JWT token (instead of username and password; the way in when 2FA is on)",
        "input_type": "password",
        "secret": true
      }
    ],
    "max_instances": 0
  },
  "config": [],
  "env": {},
  "agent_env": {},
  "assignment_mode": "explicit",
  "exclude_from": [],
  "skills": [],
  "system_requirements": {
    "node_min": "22"
  },
  "patched": false,
  "patch_note": null,
  "network_targets": [
    {
      "source": "instance",
      "host_key": "UPTIME_KUMA_URL",
      "port_default": 3001
    }
  ]
}
